# Local development with Docker
# DATABASE_URL="postgresql://postgres:postgres@db:5432/safetyband"
# DIRECT_DATABASE_URL=""

# Production with Render.com
# Use the Render PostgreSQL external URL with ?schema=public
DATABASE_URL="postgresql://username:password@dpg-xxxxx.oregon-postgres.render.com/database_name?schema=public"
DIRECT_DATABASE_URL="postgresql://username:password@dpg-xxxxx.oregon-postgres.render.com/database_name?schema=public"

NODE_ENV=development
PORT=3000
JWT_SECRET="your-super-secret-key-change-in-production"
